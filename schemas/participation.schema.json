{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heyncth/Hackathon-Project-Archive/schemas/participation.schema.json",
  "title": "Participation",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "project_id", "event_id", "award_name", "award_category", "evidence_ids", "verified"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "event_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "award_name": { "type": ["string", "null"], "minLength": 1 },
    "award_category": { "type": ["string", "null"], "minLength": 1 },
    "evidence_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "verified": { "type": "boolean" }
  }
}
