{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heyncth/Hackathon-Project-Archive/schemas/project.schema.json",
  "title": "Project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "name", "description", "categories", "tags", "status",
    "repository_ids", "official_url", "demo_url", "participation_ids",
    "technologies", "evidence_ids", "metrics_ids", "popularity",
    "documentation_quality", "reproducibility", "verification_status",
    "educational_value", "guide_ids", "first_seen", "last_checked",
    "limitations", "notes"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "categories": {
      "type": "array",
      "items": { "enum": ["award-winning", "community-notable"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "status": { "enum": ["active", "archived", "unknown"] },
    "repository_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "official_url": { "type": ["string", "null"], "format": "uri" },
    "demo_url": { "type": ["string", "null"], "format": "uri" },
    "participation_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "technologies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "evidence_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "metrics_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "popularity": { "enum": ["high", "moderate", "limited", "unknown"] },
    "documentation_quality": { "enum": ["strong", "partial", "limited", "unknown"] },
    "reproducibility": { "enum": ["tested", "documented-not-tested", "not-assessed"] },
    "verification_status": { "enum": ["verified", "partially-verified", "unverified", "disputed"] },
    "educational_value": { "enum": ["high", "moderate", "low", "unknown"] },
    "guide_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "first_seen": { "type": "string", "format": "date-time" },
    "last_checked": { "type": "string", "format": "date-time" },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": ["string", "null"] }
  }
}
