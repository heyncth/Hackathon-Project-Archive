{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heyncth/Hackathon-Project-Archive/schemas/repository.schema.json",
  "title": "Repository",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "project_id", "url", "relationship", "primary_language", "license", "last_checked"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "url": { "type": "string", "format": "uri" },
    "relationship": { "enum": ["original", "related", "reference"] },
    "primary_language": { "type": ["string", "null"] },
    "license": { "type": ["string", "null"] },
    "last_checked": { "type": "string", "format": "date-time" }
  }
}
